{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "juicy-merge",
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "menu": {
    "items": [
      {
        "label": "Create Juicy Merge Post",
        "description": "Create a new Juicy Merge game post",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/create-post"
      },
      {
        "label": "Remove Juicy Merge Post",
        "description": "Remove this Juicy Merge game post",
        "forUserType": "moderator",
        "location": "post",
        "endpoint": "/internal/menu/remove-post"
      }
    ]
  },  
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}